{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Prepare output folder",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-NonInteractive",
                "-Command",
                "New-Item -ItemType Directory -Force -Path '${workspaceFolder}/bin' | Out-Null"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build ParkingLotManager",
            "type": "process",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-std=c++20",
                "-Wall",
                "-Wextra",
                "-g",
                "main.cpp",
                "database.cpp",
                "inputValidation.cpp",
                "parkingLot.cpp",
                "vehicle.cpp",
                "-lpqxx",
                "-lpq",
                "-o",
                "bin/ParkingLotManager.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
                }
            },
            "dependsOn": "Prepare output folder",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
